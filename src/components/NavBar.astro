---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import LangPicker from "./LangPicker.astro";
import { Image } from "astro:assets";

const github = "https://github.com/lumikalt/pic1";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<nav>
  <div>
    <LangPicker lang={lang} />

    <hr />

    <a href={translatePath("/")} target="_self"> {t("nav.home")}</a>

    <ul>
      <li>
        <a href={translatePath("/about")} target="_self">{t("nav.about")}</a>
      </li>
      <li>
        <a href={translatePath("/blog")} target="_self">{t("nav.posts")}</a>
      </li>
      <li><a href={github} target="_blank" rel="noreferrer">Github</a></li>
    </ul>
  </div>

  <div>
    <Image
      src="/Tecnico_ID_Principal_RBG-BRANCO.png"
      alt={t("alt.ist")}
      class="nav-logo"
      width=100
      height=100
    />
    <Image
      src="/IT.png"
      alt={t("alt.it")}
      class="nav-logo"
      width=100
      height=100
    />
    <Image
      src="/logo.png"
      alt={t("alt.logo")}
      class="nav-logo"
      width=100
      height=100
    />
  </div>
</nav>
