---
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from "../i18n/utils";
import LangPicker from "./LangPicker.astro";
import { Image } from "astro:assets";

const github = "https://github.com/lumikalt/pic1";
const email = "mailto:mailto:geral.lab_in_a_cube@outlook.com";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<div class="nav-wrapper">
  <input type="checkbox" id="nav-toggle" class="nav-toggle" />

  <label
    for="nav-toggle"
    class="nav-toggle-label"
    aria-label="Toggle navigation"
  >
    <span></span>
    <span></span>
    <span></span>
  </label>

  <nav id="site-nav">
    <div>
      <LangPicker lang={lang} />
      <hr />
      <ul>
        <li>
          <a href={translatePath("/")} target="_self"> {t("nav.home")}</a>
        </li>
        <li>
          <a href={translatePath("/about")} target="_self">{t("nav.about")}</a>
        </li>
        <li>
          <a href={translatePath("/blog")} target="_self">{t("nav.posts")}</a>
        </li>
        <li><a href={github} target="_blank" rel="noreferrer">Github</a></li>
        <li><a href={email} target="_blank" rel="noreferrer">Email</a></li>
      </ul>
    </div>

    <div>
      <Image
        src="/Tecnico_ID_Principal_RBG-BRANCO.png"
        alt={t("alt.ist")}
        class="nav-logo"
        width="100"
        height="100"
      />
      <Image
        src="/IT.png"
        alt={t("alt.it")}
        class="nav-logo"
        width="100"
        height="100"
      />
      <Image
        src="/logo.png"
        alt={t("alt.logo")}
        class="nav-logo"
        width="100"
        height="100"
      />
    </div>
  </nav>
</div>
