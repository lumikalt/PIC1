---
import { getLangFromUrl, useTranslations, useTranslatedPath } from "../i18n/utils";
import LangPicker from "./LangPicker.astro";

const github = "https://github.com/lumikalt/pic1";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<nav>
  <div>
    <LangPicker lang={lang} />

    <hr>

    <a href={translatePath("/")} target="_self"> {t("nav.home")}</a>

    <ul>
      <li><a href={translatePath("/about")} target="_self">{t("nav.about")}</a></li>
      <li><a href={translatePath("/blog")} target="_self">{t("nav.posts")}</a></li>
      <li><a href={github} target="_blank" rel="noreferrer">Github</a></li>
    </ul>
  </div>
</nav>
