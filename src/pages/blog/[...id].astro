---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

type Props = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // Only include non-pt posts for the top-level /blog route
  const filtered = posts.filter((p: Props) => (p.data.lang ?? "en") !== "pt");
  return filtered.map((post: Props) => {
    const idParts = Array.isArray(post.id) ? post.id : String(post.id).split("/");
    const paramid = idParts.length === 1 ? idParts[0] : idParts;
    return {
      params: { id: paramid },
      props: post,
    };
  });
}

const post = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data}>
  <Content />
</BlogPost>
