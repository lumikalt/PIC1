---
import { type CollectionEntry, getCollection } from "astro:content";
import BlogPost from "../../layouts/BlogPost.astro";

type Props = CollectionEntry<"blog">;

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  // Only include non-pt posts for the top-level /blog route
  const filtered = posts.filter((p: Props) => (p.data.lang ?? "en") !== "pt");
  return filtered.map((post: Props) => {
    const slugParts = Array.isArray(post.slug) ? post.slug : String(post.slug).split("/");
    const paramSlug = slugParts.length === 1 ? slugParts[0] : slugParts;
    return {
      params: { slug: paramSlug },
      props: post,
    };
  });
}

const post = Astro.props;
const { Content } = await post.render();
---

<BlogPost {...post.data}>
  <Content />
</BlogPost>
