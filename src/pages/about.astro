---
import "../styles/style.scss";

import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import NavBar from "../components/NavBar.astro";
import { Image } from "astro:assets";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <BaseHead title="About Us" description="" author="PIC1" />
  </head>

  <body>
    <div class="scan-line"></div>

    <NavBar />

    <div class="frame">
      <article>
        <header class="center">
          <h2 transition:animate="slide">About Us</h2>
        </header>

        <main transition:animate="slide">
          <h1>Team</h1>

          <hr class="separator" />

          <div class="student">
            <Image
              src="/photos/cristina.jpg"
              alt=""
              width={200}
              height={200}
              loading="lazy"
            />

            <div class="student-info">
              <h3>Cristina Wang - ist1109386 - Boards</h3>
              <p>
                Making the PCBs in Kicad, researching and ordering components,
                building the prototype board.
              </p>
            </div>
          </div>

          <hr class="separator" />

          <div class="student">
            <div class="photo-placeholder" aria-hidden="true"></div>
            <div class="student-info">
              <h3>Lexin Weng - ist1110627 - Box Structure</h3>
              <p>
                Making 3D exterior model, the general internal layout, and the
                modularity of the design.
              </p>
            </div>
          </div>

          <hr class="separator" />

          <div class="student">
            <div class="photo-placeholder" aria-hidden="true"></div>
            <div class="student-info">
              <h3>Lumi Pereira - ist1109813 - ESP32 + Serial Comms</h3>
              <p>
                Writing the website, programming the micro-controllera, and
                comms between sensors.
              </p>
            </div>
          </div>

          <hr class="separator" />

          <div class="student">
            <Image
              src="/photos/sara.png"
              alt=""
              width={200}
              height={200}
              loading="lazy"
            />
            <div class="student-info">
              <h3>Sara Pereira - ist1109311 - Ground Station</h3>
              <p>
                Researching the Ground Station, implementing it in Arduino IDE,
                and programming comms between the antennas.
              </p>
            </div>
          </div>

          <hr class="separator" />

          <div class="student">
            <Image
              src="/photos/tiago.png"
              alt=""
              width={200}
              height={200}
              loading="lazy"
            />
            <div class="student-info">
              <h3>Tiago Duanmu - ist1111173 - Power</h3>
              <p>
                Managing the satellite power budget, researching solar panels
                and batteries, and designing the power system and connections.
              </p>
            </div>
          </div>

          <hr class="separator" />

          <div class="student">
            <div class="photo-placeholder" aria-hidden="true"></div>
            <div class="student-info">
              <h3>Yaqi Xu - ist1103762 - Algorithms and Control</h3>
              <p>
                Researching sensor usage, evaluating the project results,
                producing the final video, and poster.
              </p>
            </div>
          </div>

          <h2>Email</h2>

          <p>
            For any inquiries, please
            <a href="mailto:geral.lab_in_a_cube@outlook.com">contact us</a>.
          </p>

          <hr class="separator" />

          <h1>Professors</h1>
          <p>
            <strong>Scientific Advisor</strong>: Professor Ayman Radwan
            <br />
            <strong>Scientific Co-advisor</strong>: Professor Mariana Santana
            <br />
            <strong>Coordinator</strong>: Professor Carlos Fernandes
            <br />
            <strong>Mentor</strong>: Professor João Felício
          </p>
        </main>

        <Footer />
      </article>
    </div>
  </body>
</html>
